{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtislms",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js", 
  "assets": {
    "directory": "dist/client", 
    "binding": "ASSETS"
  },
  "build": {
    "command": "bun run build"
  },
}
